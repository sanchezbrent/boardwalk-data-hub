{
  "name": "boardwalk-data-hub",
  "version": "0.1.0",
  "description": "Reviewed Data Hub editor plugin and the first Boardwalk plugin contract pilot.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.5 <23"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./synthetic": {
      "types": "./dist/synthetic.d.ts",
      "import": "./dist/synthetic.js"
    },
    "./host-adapter": {
      "types": "./dist/host-adapter.d.ts",
      "import": "./dist/host-adapter.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs",
    "examples/boardwalk"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --experimental-test-coverage tests/*.test.mjs",
    "check:policy": "node scripts/check-policy.mjs",
    "check": "npm run typecheck && npm test && npm run check:examples && npm run check:policy && npm run format:check",
    "demo": "npm run build && node scripts/demo-server.mjs",
    "inventory": "npm run build && node scripts/inventory.mjs",
    "prepack": "npm run build",
    "test:browser": "playwright test",
    "pack:check": "node scripts/pack-check.mjs",
    "check:examples": "tsc -p tsconfig.examples.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.1",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.0",
    "react": "18.3.1",
    "@types/react": "18.3.27",
    "prettier": "3.10.1"
  }
}
